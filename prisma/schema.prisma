generator client {
  provider = "prisma-client-js"
  // output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

//! Below here everything is written by me, NO AI TOOLS USED

// User model
// basically relies on clerk for auht
model User {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  clerkUserId String        @unique
  rssFeeds    RssFeed[]
  newsletters Newsletter[]
  settings    UserSettings?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model UserSettings {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique  @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)


  //B Settings
  newsletterName  String?
  description     String?
  targetAudience  String?
  defaultTone     String?

  //Branding Settings
  brandVoice  String?
  companyName String?
  industry    String?

  //More Information
  disclaimerText String?
  defaultTags    String[]
  customFooter   String?
  senderName     String?
  senderEmail    String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

}

//Rss feed model: Stores the info and metadata for the feed

model RssFeed{
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  url         String
  title       String?
  description String?
  link        String?
  imageUrl    String?
  language    String?
  lastFetched DateTime?
  article     RssArticle[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([userId, url]) 
  @@index([userId]) 
}

//RSS Article
model RssArticle{
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  feedId        String    @db.ObjectId
  feed          RssFeed   @relation(fields: [feedId], references: [id], onDelete: NoAction)
  guid          String    @unique 
  sourceFeedIds String[]  @db.ObjectId 
  title         String
  link          String
  content       String? // Article Content [Full]
  summary       String? // Article Summary
  pubDate       DateTime
  author        String?
  categories    String[] //Array of categories
  imageUrl      String?  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([feedId])
  @@index([pubDate])
  @@index([feedId, pubDate])
  @@index([sourceFeedIds])
}

// Newsletter Generation
model Newsletter {
  id                 String        @id @default(auto()) @map("_id") @db.ObjectId
  userId             String        @db.ObjectId
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestedTitles    String[]
  suggestedSubjectLines String[] 
  body                  String
  topAnnouncements      String[]
  additionalInfo        String?
  startDate             DateTime
  endDate               DateTime
  userInput             String? 
  feedsUsed             String[]   @db.ObjectId
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
  @@index([createdAt])

}


